# SQLRAG Configuration
# Database Configuration
# Dev default uses SQLite; switch to Postgres by setting DATABASE_URL or the Postgres fields below.
DATABASE_USERNAME=sqlite
DATABASE_NAME=sqlrag.db
# DATABASE_HOSTNAME=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=sqlrag
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=password

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional: OpenAI (non-Azure) Configuration
# If you set these, the backend will fall back to OpenAI when Azure vars are not set.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security
SECRET_KEY=please-change-me
JWT_ALGORITHM=HS256

# Application Configuration
LOG_LEVEL=INFO
DATA_PATH=financial_data.json
AGENT_OFFLINE_MODE=false
FEATURE_AGENT_ENABLED=false

# Performance Configuration
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=60

# Optional: override URLs (set to sync driver for SQLAlchemy sync clients)
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/sqlrag
